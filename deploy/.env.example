# PandaEye docker-compose environment. Copy to deploy/.env with scripts/gen-env.sh (fills every secret
# with fresh random values) or by hand. Never commit deploy/.env (deploy/.gitignore excludes it).
#
# Secrets are left commented out on purpose: an unset secret makes the service that needs it refuse to
# start (PandaEye rejects an empty PE_OUTBOUND_KEY or PE_LICENSE_PEPPER, the Postgres image refuses an
# empty superuser password) instead of running with a known default. NATS uses per-role creds files
# from `make nats-auth` (deploy/nats/auth/, never in this file).
# Generate a value by hand with:   openssl rand -hex 32   (keys/tokens)   openssl rand -hex 24  (passwords)
# Hex is used everywhere because it is safe in URLs, headers and YAML, and a 64-character hex string is
# >= 32 bytes whether a component reads it raw or hex-decoded (the spec does not fix the encoding).

# --------------------------------------------------------------------------- images
# Built locally by `make -C deploy image` unless you point this at a registry tag.
PANDAEYE_IMAGE=pandaeye:dev
# Infrastructure images from mirror.gcr.io (a Docker Hub pull-through mirror). Upstream names:
#   docker.io/library/nats:2.15-alpine, docker.io/library/postgres:17-alpine,
#   docker.io/clickhouse/clickhouse-server:25.8
NATS_IMAGE=mirror.gcr.io/library/nats:2.15-alpine
POSTGRES_IMAGE=mirror.gcr.io/library/postgres:17-alpine
CLICKHOUSE_IMAGE=mirror.gcr.io/clickhouse/clickhouse-server:25.8

# --------------------------------------------------------------------------- published ports
# Host addresses for the gateway (/v1/connect, /healthz, /status) and the REST API. Loopback by default:
# put a TLS terminator in front (docs/OPERATIONS.md "TLS termination"). Plugins accept ws:// only to
# loopback, so a plugin on this host can use ws://127.0.0.1:8080/v1/connect for testing.
GATEWAY_BIND=127.0.0.1:8080
API_BIND=127.0.0.1:8081

# --------------------------------------------------------------------------- PandaEye settings
# Every key is described in docs/OPERATIONS.md "Configuration reference".
PE_REGION=local
PE_LOG_LEVEL=info
# Fixed for the lifetime of the deployment (stored in KV PE_META); see OPERATIONS "Scaling partitions".
PE_PARTITIONS=16
PE_PUBLIC_URL=
# CIDRs of your TLS terminator / load balancer, comma separated (X-Forwarded-For, CF-Connecting-IP).
PE_TRUSTED_PROXIES=
PE_EVENTS_MAX_AGE=24h
PE_EVENTS_MAX_BYTES=10GiB
PE_WORKER_MAX_MEMORY=2GiB

# Licensing: `static` (PE_STATIC_LICENSES) or `pandascript` (PE_LICENSE_URL, https only).
PE_LICENSE_MODE=static
PE_LICENSE_URL=
PE_LICENSE_PRODUCT=pandaeye
# key[:maxServers[:plan]],...  The key must pass the licence key format check of the build you run.
# PE_STATIC_LICENSES=

# --------------------------------------------------------------------------- secrets (generated)
# HMAC key for SignedOutbound; webhook encryption and appeal codes are derived from it. Same value on
# gateway, verdict and api. Changing it is disruptive: docs/OPERATIONS.md "Rotating keys".
# PE_OUTBOUND_KEY=
# HMAC key of licence lookups (licenses.key_hmac). Same value on gateway and api. Never rotate it.
# PE_LICENSE_PEPPER=
# Dashboard -> API transport token and user assertion key (also set in the dashboard Worker secrets).
# PE_SERVICE_TOKEN=
# PE_ASSERTION_KEY=

# Datastores
# POSTGRES_PASSWORD=
# CLICKHOUSE_PASSWORD=
