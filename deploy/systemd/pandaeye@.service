# PandaEye split role: pandaeye@gateway, pandaeye@worker, pandaeye@verdict, pandaeye@api.
# The instance name is the subcommand; run one instance per role per host (scale workers with hosts).
# Lease owner ids default to "<role>-<hostname>" (PE_OWNER_ID), so instances on different hosts differ.
#
# Run database migrations once per release before starting the roles (no NATS needed):
#   systemd-run --wait --pipe -p DynamicUser=yes -p EnvironmentFile=/etc/pandaeye/pandaeye.env \
#     /usr/local/bin/pandaeye migrate
#
# Files (root-owned; systemd hands copies to the dynamic user through the credentials directory):
#   /etc/pandaeye/pandaeye.env          settings shared by every role (PE_DB_*, PE_OUTBOUND_KEY, ...)
#   /etc/pandaeye/<role>.env            optional role-specific settings (e.g. gateway: PE_LICENSE_PEPPER)
#   /etc/pandaeye/nats/pe-<role>.creds  NATS creds from deploy/nats/gen-auth (mode 0600 is fine)
#   /etc/pandaeye/nats/ca.pem           CA of the NATS server certificate
# Set PE_NATS_URL (tls://...) in pandaeye.env. See docs/OPERATIONS.md "Configuration reference".

[Unit]
Description=PandaEye %i
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/pandaeye %i
EnvironmentFile=/etc/pandaeye/pandaeye.env
EnvironmentFile=-/etc/pandaeye/%i.env
# The unit fails to start when a credential file is missing.
LoadCredential=nats.creds:/etc/pandaeye/nats/pe-%i.creds
LoadCredential=nats-ca.pem:/etc/pandaeye/nats/ca.pem
Environment=PE_NATS_CREDS=%d/nats.creds PE_NATS_TLS_CA=%d/nats-ca.pem
DynamicUser=yes
UMask=0077

# Direct TLS for the gateway or API (else terminate TLS in front):
#LoadCredential=tls.crt:/etc/pandaeye/tls/fullchain.pem
#LoadCredential=tls.key:/etc/pandaeye/tls/privkey.pem
#Environment=PE_TLS_CERT=%d/tls.crt PE_TLS_KEY=%d/tls.key

KillSignal=SIGTERM
TimeoutStopSec=20s
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Hardening (same profile as pandaeye.service)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
