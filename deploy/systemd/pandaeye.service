# PandaEye all-in-one (`pandaeye all`: embedded NATS + gateway + worker + verdict + api, sqlite).
# For split roles use pandaeye@.service (pandaeye@gateway, pandaeye@worker, ...).
#
# Install:
#   install -m 0755 pandaeye /usr/local/bin/pandaeye
#   install -d -m 0750 /etc/pandaeye && install -m 0600 pandaeye.env /etc/pandaeye/pandaeye.env
#   install -m 0644 pandaeye.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now pandaeye
# Data (embedded JetStream ./data/nats, sqlite ./data/pandaeye.db, the generated licence pepper and
# outbound key in the database) lives in /var/lib/pandaeye (/var/lib/private/pandaeye with DynamicUser).
# Back it up as described in docs/OPERATIONS.md "Backups and disaster recovery".

[Unit]
Description=PandaEye cloud anticheat (all-in-one)
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/pandaeye all
# PE_* settings and secrets; read by systemd as root before privileges are dropped.
EnvironmentFile=/etc/pandaeye/pandaeye.env
DynamicUser=yes
StateDirectory=pandaeye pandaeye/data
StateDirectoryMode=0700
WorkingDirectory=/var/lib/pandaeye
UMask=0077

# Direct TLS (PE_TLS_CERT/PE_TLS_KEY) without making the key readable by the dynamic user: systemd
# copies the files into a private credentials directory. Uncomment and point at your certificate.
#LoadCredential=tls.crt:/etc/pandaeye/tls/fullchain.pem
#LoadCredential=tls.key:/etc/pandaeye/tls/privkey.pem
#Environment=PE_TLS_CERT=%d/tls.crt PE_TLS_KEY=%d/tls.key
# Listening on a port below 1024 (e.g. PE_GATEWAY_LISTEN=:443) additionally needs:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# and PrivateUsers=no below.

# Graceful shutdown: connections get CODE_SHUTTING_DOWN, leases are released, stores flushed (<= 10 s).
KillSignal=SIGTERM
TimeoutStopSec=20s
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536

# Hardening
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
DevicePolicy=closed

[Install]
WantedBy=multi-user.target
